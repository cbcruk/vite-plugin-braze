{
  "name": "braze-x",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter vite-plugin-braze build",
    "dev": "pnpm build && vp dev",
    "test": "pnpm build && vp test",
    "test:run": "pnpm build && vp test run",
    "typecheck": "pnpm build && tsc --noEmit && pnpm --filter vite-plugin-braze typecheck",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plugin-braze": "workspace:*",
    "vite-plus": "catalog:"
  }
}
